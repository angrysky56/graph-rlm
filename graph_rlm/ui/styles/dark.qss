
/* Main Window */
QMainWindow {
    background-color: #1e1e1e;
    color: #e0e0e0;
}

/* Widgets */
QWidget {
    background-color: #1e1e1e;
    color: #e0e0e0;
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 14px;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #2b2b2b;
    width: 10px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: #4a4a4a;
    min-height: 20px;
    border-radius: 5px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: #2b2b2b;
    height: 10px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:horizontal {
    background: #4a4a4a;
    min-width: 20px;
    border-radius: 5px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

/* Inputs */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #2b2b2b;
    border: 1px solid #3d3d3d;
    border-radius: 4px;
    color: #e0e0e0;
    padding: 5px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #007acc;
}

/* Buttons */
QPushButton {
    background-color: #3a3a3a;
    border: 1px solid #505050;
    border-radius: 4px;
    padding: 6px 12px;
    color: #ffffff;
}
QPushButton:hover {
    background-color: #4a4a4a;
    border: 1px solid #606060;
}
QPushButton:pressed {
    background-color: #007acc;
    border: 1px solid #005c99;
}
QPushButton:disabled {
    background-color: #2a2a2a;
    color: #707070;
    border: 1px solid #3a3a3a;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #3d3d3d;
    background: #1e1e1e;
}
QTabBar::tab {
    background: #2b2b2b;
    color: #a0a0a0;
    border: 1px solid #3d3d3d;
    border-bottom: none;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background: #1e1e1e;
    color: #ffffff;
    border-top: 2px solid #007acc;
}
QTabBar::tab:hover {
    background: #333333;
}

/* Dock Widget */
QDockWidget {
    titlebar-close-icon: url(close.png);
    titlebar-normal-icon: url(undock.png);
}
QDockWidget::title {
    text-align: left;
    background: #252526;
    padding-left: 5px;
    border-bottom: 1px solid #3d3d3d;
}

/* Graph View */
QGraphicsView {
    border: none;
    background-color: #121212; /* Darker background for graph */
}

/* Labels */
QLabel {
    color: #cccccc;
}

/* Headers */
QHeaderView::section {
    background-color: #252526;
    color: #e0e0e0;
    padding: 4px;
    border: 1px solid #3d3d3d;
}
