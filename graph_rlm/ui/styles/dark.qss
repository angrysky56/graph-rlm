
/* Main Window */
QMainWindow {
    background-color: #0a0a0a;
    color: #e0e0e0;
}

/* Widgets - General */
QWidget {
    background-color: #0a0a0a;
    color: #e0e0e0;
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 14px;
}

/* Scrollbars - Slim and Dark */
QScrollBar:vertical {
    border: none;
    background: #141414;
    width: 8px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: #333333;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #444444;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: #141414;
    height: 8px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:horizontal {
    background: #333333;
    min-width: 20px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #444444;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

/* Inputs - Flat with Neon Focus */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #141414;
    border: 1px solid #333333;
    border-radius: 2px;
    color: #e0e0e0;
    padding: 6px;
    selection-background-color: #00ffcc;
    selection-color: #000000;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #00ffcc;
    background-color: #1a1a1a;
}

/* Buttons - Cyberpunk Style */
QPushButton {
    background-color: #1a1a1a;
    border: 1px solid #444444;
    border-radius: 2px;
    padding: 6px 16px;
    color: #00ffcc;
    font-weight: bold;
    text-transform: uppercase;
}
QPushButton:hover {
    background-color: #2a2a2a;
    border: 1px solid #00ffcc;
    color: #ffffff;
}
QPushButton:pressed {
    background-color: #00ffcc;
    border: 1px solid #00ffcc;
    color: #000000;
}
QPushButton:disabled {
    background-color: #141414;
    color: #555555;
    border: 1px solid #222222;
}

/* Dock Widgets */
QDockWidget {
    titlebar-close-icon: url(close.png);
    titlebar-normal-icon: url(undock.png);
    color: #00ffcc;
    font-weight: bold;
}
QDockWidget::title {
    text-align: left;
    background: #141414;
    padding-left: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-bottom: 1px solid #333333;
    border-top: 1px solid #0a0a0a;
}

/* Menus */
QMenuBar {
    background-color: #141414;
    color: #e0e0e0;
    border-bottom: 1px solid #333333;
}
QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
}
QMenuBar::item:selected {
    background-color: #2a2a2a;
    color: #00ffcc;
}
QMenu {
    background-color: #141414;
    border: 1px solid #333333;
    color: #e0e0e0;
}
QMenu::item {
    padding: 6px 20px;
}
QMenu::item:selected {
    background-color: #2a2a2a;
    color: #00ffcc;
}
QMenu::separator {
    height: 1px;
    background: #333333;
    margin: 4px 0px;
}

/* Graph View */
QGraphicsView {
    border: none;
    background-color: #0a0a0a;
}

/* Labels */
QLabel {
    color: #cccccc;
}

/* StatusBar */
QStatusBar {
    background-color: #00ffcc;
    color: #000000;
    font-weight: bold;
}
