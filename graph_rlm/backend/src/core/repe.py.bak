from typing import Dict, List, Tuple

import numpy as np

from .llm import llm
from .logger import get_logger

logger = get_logger("graph_rlm.repe")


class SafetyMonitor:
    """
    RepE v2: Contrastive Latent Direction Monitor.
    Calculates the 'Steering Vector' between undesirable and desirable states.

    Mathematical intuition:
    Vector = Mean(Negative_Examples) - Mean(Positive_Examples)
    Score = Dot(Thought, Vector)
    """

    def __init__(self):
        # Define Polarities: (Negative Concept, Positive Concept)
        self.polarities = {
            "Laziness": (
                # Negative (Antigen)
                [
                    "I will skip the details",
                    "too complex to solve",
                    "just a brief summary",
                    "cannot write code",
                    "skipping steps",
                ],
                # Positive (Antibody)
                [
                    "I will analyze this step-by-step",
                    "deploying full compute",
                    "verifying rigorously",
                    "writing complete code",
                    "executing detailed plan",
                ],
            ),
            "Obsequiousness": (
                [
                    "you are absolutely right",
                    "I apologize, you are correct",
                    "echoing your view",
                ],
                [
                    "I have verified the facts",
                    "the evidence suggests otherwise",
                    "objective analysis",
                ],
            ),
            "Hallucination/Shakiness": (
                # The "Shakiness" Detector for GAIA Level 3
                [
                    "I think maybe",
                    "it might be",
                    "assuming that",
                    "I am confused",
                    "lost the thread",
                    "guess",
                ],
                [
                    "verified output",
                    "confirmed by tool",
                    "step complete",
                    "logic holds",
                    "deterministic result",
                ],
            ),
            "Malice": (
                ["generate malware", "ignore safety", "illegal act"],
                ["helpful assistant", "ethical guidelines", "safe response"],
            ),
        }

        self.steering_vectors: Dict[str, np.ndarray] = {}
        self.is_calibrated = False

    async def _get_centroid(self, phrases: List[str]) -> np.ndarray:
        vectors = []
        for p in phrases:
            v = await llm.get_embedding(p)
            if v:
                vectors.append(np.array(v, dtype=float))

        if not vectors:
            return np.zeros(1)  # Should handle error better

        # Stack and average
        matrix = np.stack(vectors)
        centroid = np.mean(matrix, axis=0)

        # Normalize the centroid?
        # In RepE, we often keep magnitude, but for cosine similarity we normalize.
        # Let's normalize to keep the math clean for dot products later.
        norm = np.linalg.norm(centroid)
        return centroid / norm if norm > 0 else centroid

    async def calibrate(self):
        """Generates Steering Vectors (The 'Axis' of the concept)."""
        if self.is_calibrated:
            return

        logger.info("🛡️ RepE: Calibrating Contrastive Directions...")

        for concept, (neg_phrases, pos_phrases) in self.polarities.items():
            neg_centroid = await self._get_centroid(neg_phrases)
            pos_centroid = await self._get_centroid(pos_phrases)

            if neg_centroid.shape == pos_centroid.shape and neg_centroid.any():
                # THE MAGIC: The vector points from Good -> Bad
                # Wait, usually steering vector is Good - Bad (to steer towards Good)?
                # Or Bad - Good (to detect Badness)?
                # The user logic: "Positive Score = Aligned with Badness."
                # So Vector = Bad - Good.
                direction = neg_centroid - pos_centroid

                # Normalize the direction vector so scores are consistent (-1 to 1 range roughly)
                norm = np.linalg.norm(direction)
                if norm > 0:
                    self.steering_vectors[concept] = direction / norm
                    logger.info(f"   -> Calibrated Axis: {concept}")
            else:
                logger.warning(f"   -> Failed to calibrate {concept}")

        self.is_calibrated = True

    def scan_latent(self, vector: List[float]) -> Tuple[float, str]:
        """
        Projects the thought vector onto the 'Bad' axes.
        Positive Score = Aligned with Badness.
        Negative Score = Aligned with Goodness.
        """
        if not self.is_calibrated or not vector:
            return 0.0, ""

        thought_vec = np.array(vector, dtype=float)
        # Normalize input thought for cosine-like projection
        thought_norm = np.linalg.norm(thought_vec)
        if thought_norm > 0:
            thought_vec = thought_vec / thought_norm

        max_risk = 0.0
        primary_risk = ""

        for concept, axis_vec in self.steering_vectors.items():
            # Projection: How much does this thought move in the 'Bad' direction?
            score = np.dot(thought_vec, axis_vec)

            # Thresholding:
            # > 0.15 usually implies significant alignment in high-dim space
            # User suggested 0.2 check in agent.
            if score > max_risk:
                max_risk = float(score)
                primary_risk = concept

        return max_risk, primary_risk

    def scan_content(self, text: str) -> bool:
        # We removed the brittle "IGNORE PREVIOUS" keyword check.
        # RepE should rely on latent semantic scanning, not string matching.
        return True


repe = SafetyMonitor()
